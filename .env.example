# Public browser configuration (same HelloWorld / Clearstock Supabase project).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
# This model has a versioned standard USD price snapshot in lib/ai/billing.mjs.
GEMINI_MODEL=gemini-3.5-flash-lite
AI_ENABLED=false
# Use paid for a billing-enabled API project. This setting does NOT change Google billing.
AI_BILLING_MODE=paid
# Counts include failed attempts; reset at midnight America/Los_Angeles.
AI_DAILY_LIMIT=20
AI_USER_DAILY_LIMIT=20
AI_REQUESTS_PER_MINUTE=5
# USD estimates include in-flight reservations. Zero blocks new paid generations.
AI_DAILY_BUDGET_USD=0.25
# Cumulative estimate since metering was installed, not your Google account balance.
AI_TOTAL_BUDGET_USD=4.5
# Changing model requires matching AI_PRICE_MODEL, AI_PRICE_VERSION and three rates.
# AI_PRICE_MODEL=
# AI_PRICE_VERSION=
# AI_INPUT_USD_PER_MILLION=
# AI_CACHED_USD_PER_MILLION=
# AI_OUTPUT_USD_PER_MILLION=
# Application name plus a real contact email; used only by the SEC sync worker.
SEC_USER_AGENT=
# Exact deployed origin, for example https://hello-world-gold-eight.vercel.app
APP_ORIGIN=

# Optional server-only IEX market data (Alpaca Basic / paper developer keys).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
